{
    "buildPresets": [
        {
            "configurePreset": "Simulator",
            "displayName": "Simulator",
            "name": "Simulator"
        },
        {
            "configurePreset": "Debug",
            "displayName": "Debug",
            "name": "Debug"
        },
        {
            "configurePreset": "RelWithDebInfo",
            "displayName": "Release (with debug info)",
            "name": "RelWithDebInfo"
        }
    ],
    "configurePresets": [
        {
            "binaryDir": "${sourceDir}/build/${presetName}",
            "generator": "Ninja",
            "hidden": true,
            "name": "default"
        },
        {
            "hidden": true,
            "inherits": "default",
            "name": "default-target",
            "toolchainFile": "${sourceDir}/cmake/toolchains/gcc-arm-none-eabi.cmake"
        },
        {
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Simulator"
            },
            "displayName": "Simulator",
            "inherits": "default",
            "name": "Simulator"
        },
        {
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "displayName": "Debug",
            "inherits": "default-target",
            "name": "Debug"
        },
        {
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            },
            "displayName": "Release (with debug info)",
            "inherits": "default-target",
            "name": "RelWithDebInfo"
        }
    ],
    "version": 3
}
